# Environment Variables — Campus Exchange

# Database Configuration (Defaults to local file H2 if unset)
# DB_URL=jdbc:postgresql://localhost:5432/campus_exchange
# DB_USER=postgres
# DB_PASS=postgres_secure_password

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_minimum_32_characters

# University Email Domain Whitelist (comma-separated, e.g. 'university.edu,student.university.edu')
# Leave empty during local testing to allow any email domain.
UNIVERSITY_EMAIL_DOMAINS=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Application Metadata
APP_NAME=Campus Exchange
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL=₹
REQUEST_EXPIRY_HOURS=72
MAX_IMAGES_PER_LISTING=5
MAX_IMAGE_SIZE_MB=5
