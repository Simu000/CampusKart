# =======================================
# Campus Exchange — Environment Variables
# =======================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL - Core Marketplace)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_exchange
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Database (MongoDB - Private Chat & Messaging)
MONGO_URI=mongodb://localhost:27017/campus_exchange

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_minimum_32_characters
JWT_EXPIRY_DAYS=7

# University Email Domain Whitelist (comma-separated, e.g. 'chitkara.edu.in')
UNIVERSITY_EMAIL_DOMAINS=chitkara.edu.in

# Email Dispatch (Dev: logs links to console. Prod: set SMTP credentials)
EMAIL_FROM=noreply@campusexchange.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL (for email links & CORS)
FRONTEND_URL=http://localhost:5173

# File Uploads
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=5
MAX_IMAGES_PER_LISTING=5

# Application Metadata
APP_NAME=Campus Exchange
